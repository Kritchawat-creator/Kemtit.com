# Kemtit — environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — ห้าม commit ค่าจริง (.env* ถูก ignore แล้ว)
# ตัวแปรที่ขึ้นต้น NEXT_PUBLIC_ ถูกฝังลง client bundle — ห้ามใส่ secret

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — ใช้เฉพาะ cron/webhook ผ่าน src/lib/supabase/admin.ts ห้าม import ในโค้ดฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# URL หลักของแอป (ใช้สร้างลิงก์ในอีเมล/LINE และ redirect) — production ใส่ https://kemtit.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron (GitHub Actions → /api/cron/*) ---
# สุ่มด้วย: openssl rand -hex 32 — ต้องตรงกับ GitHub Secret CRON_SECRET
CRON_SECRET=

# --- External calendars (optional) ---
# Register these exact callback URLs with each provider for the deployed app.
# Google redirect URI:  https://<app-host>/api/calendar/google/callback
# Outlook redirect URI: https://<app-host>/api/calendar/outlook/callback
# Local development can use http://localhost:3000 with the same route paths.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=
# Generate a random key of at least 32 characters; use the same key for both providers.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- LINE Messaging API (ใช้จริง M5 — ตั้งค่าไว้ล่วงหน้าได้) ---
# LINE Developers console → Provider "Kemtit" → Messaging API channel
# ACCESS_TOKEN ว่าง = dry-run (log แทนส่งจริง) — webhook ยังต้องมี SECRET เพื่อตรวจ signature
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Basic ID ของ OA (เช่น @123abcd) สำหรับปุ่ม/QR เพิ่มเพื่อนในหน้าตั้งค่า
NEXT_PUBLIC_LINE_OA_BASIC_ID=

# --- Feature flags (src/lib/flags.ts) — "1" = เปิด, อย่างอื่น = ปิด ---
# รูปแนบงาน + รูปโปรไฟล์ (user-uploaded content ทุกชนิด) — ปิดตลอด POC/CP1 ตาม Design §6A.6, เปิดใน MVP
# netlify.toml ตั้ง 0 ทุก context · CI job "e2e-uploads" รัน e2e/photos.spec.ts ด้วยค่า 1
NEXT_PUBLIC_FLAG_UPLOADS=0
